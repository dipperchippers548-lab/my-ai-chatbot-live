# Copy this file to .env.local (never commit .env.local) and fill in what you need.

# Server only. Turns on real AI scans. Without it the server returns demo data.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Server only, optional. Which Claude model reads the photos (default: claude-opus-5-5).
# claude-haiku-5-5 costs far less per scan; test its accuracy before switching.
# MUNCHLY_MODEL=claude-opus-5-5

# Server only, optional. How hard the model thinks: low | medium | high (default: low).
# MUNCHLY_EFFORT=low

# Optional shared key between app and server. Set the same value in both.
# MUNCHLY_APP_KEY=
# EXPO_PUBLIC_MUNCHLY_APP_KEY=

# App only. Where the Android app finds the server. Leave empty for local web testing.
# EXPO_PUBLIC_API_URL=https://your-project.expo.app
