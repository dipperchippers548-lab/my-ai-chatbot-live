{
  "expo": {
    "name": "Munchly",
    "slug": "munchly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "munchly",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.munchly.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.munchly.app",
      "adaptiveIcon": {
        "backgroundColor": "#FF6A2B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF6A2B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Munchly uses your camera to photograph meals and estimate their calories.",
          "photosPermission": "Munchly uses your photos so you can scan meals you already took a picture of.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
